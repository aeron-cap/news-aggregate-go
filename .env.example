# Process environment overrides this file. Missing file/empty settings use defaults.
DATABASE_URL=postgresql://news_aggregator@127.0.0.1:5432/news_aggregator?sslmode=disable
# Set your existing PostgreSQL role password. Single quotes preserve special characters.
PGPASSWORD='replace-with-your-local-database-password'
# Empty: use the project's .venv Python when present, otherwise python on PATH.
PYTHON_BIN=
# Empty: use NLTK's standard data search paths. Set this if using a custom corpus directory.
NLTK_DATA=
# TEST_DATABASE_URL=postgresql://news_aggregator@127.0.0.1:5432/news_aggregator_test?sslmode=disable
# API listen address as host:port. Empty: 127.0.0.1:6767 (loopback only, reached through nginx).
# Avoid :6767 or 0.0.0.0:6767 in production: they expose the API on every interface and bypass nginx.
ADDR=127.0.0.1:6767
