[Unit]
Description=Pocket News API
After=network-online.target
Wants=network-online.target

[Service]
User=pocketnews
Group=pocketnews
WorkingDirectory=/opt/pocket-news/current
ExecStart=/opt/pocket-news/current/api
Environment=PYTHON_BIN=/opt/pocket-news/.venv/bin/python
Environment=NLTK_DATA=/opt/pocket-news/nltk_data
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target